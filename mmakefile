mmake: mmake.o mmake_parser.o
	gcc -o mmake mmake.o mmake_parser.o

mmake.o: mmake.c mmake_parser.h
	gcc -g -std=gnu11 -Werror -Wall -Wextra -Wpedantic -Wmissing-declarations -Wmissing-prototypes -Wold-style-definition -Wswitch-enum -c -o mmake.o mmake.c

mmake_parser.o: mmake_parser.c mmake_parser.h
	gcc -g -std=gnu11 -Werror -Wall -Wextra -Wpedantic -Wmissing-declarations -Wmissing-prototypes -Wold-style-definition -c -o mmake_parser.o mmake_parser.c

clean:
	rm mmake mmake.o mmake_parser.o

meep:
	echo Meep!

false:
	false
